# Shell scripts MUST stay LF — they run under bash (Git Bash on Windows + the NUC).
# A CRLF checkout breaks them with `$'\r': command not found`. (autocrlf is on for this repo.)
*.sh text eol=lf

# PowerShell + batch are Windows-side; keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
