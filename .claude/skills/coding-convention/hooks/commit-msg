#!/bin/sh
# MiniServer — commit-msg hook: ép Conventional Commits (tiếng Anh).
# Cài: copy file này vào <repo>/.git/hooks/commit-msg (chmod +x trên Unix).
# Nguồn chuẩn: D:\Projects\MiniServer\.claude\skills\coding-convention\hooks\commit-msg

msg_file="$1"
# Dòng tiêu đề = dòng đầu tiên không phải comment.
subject="$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)"

# Bỏ qua commit đặc biệt do git tự sinh.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"Reapply "*) exit 0 ;;
esac

# <type>(<scope>)?(!)?: <subject>   — scope tuỳ chọn, '!' đánh dấu breaking change.
pattern='^(feat|fix|refactor|chore|docs|test|perf|style|build|ci|revert)(\([a-z0-9._-]+\))?(!)?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "✖ Commit message KHÔNG đúng Conventional Commits." >&2
  echo "" >&2
  echo "  Nhận được : $subject" >&2
  echo "  Cần dạng  : <type>(<scope>): <mô tả tiếng Anh, thể mệnh lệnh>" >&2
  echo "  type      : feat fix refactor chore docs test perf style build ci revert" >&2
  echo "" >&2
  echo "  Ví dụ     : feat(auth): add Authentik login" >&2
  echo "              fix(api): handle empty tag returning 500" >&2
  exit 1
fi

# Tiêu đề không kết thúc bằng dấu chấm.
case "$subject" in
  *".") echo "✖ Tiêu đề commit không được kết thúc bằng dấu '.'  → $subject" >&2; exit 1 ;;
esac

# Mô tả (phần sau ": ") phải viết thường ở chữ đầu — trừ từ viết tắt toàn hoa (API, JWT, SSO…).
desc="${subject#*: }"
first_word="${desc%% *}"
first_char="$(printf '%s' "$desc" | cut -c1)"
case "$first_char" in
  [A-Z])
    # Có chữ thường trong từ đầu ⇒ là từ viết hoa thường (Add, Authentik) ⇒ chặn.
    # Không có chữ thường ⇒ acronym toàn hoa ⇒ cho qua.
    case "$first_word" in
      *[a-z]*)
        echo "✖ Mô tả commit phải viết thường ở chữ đầu (thể mệnh lệnh)." >&2
        echo "  Nhận được : $subject" >&2
        echo "  Sửa thành : ${subject%%: *}: $(printf '%s' "$desc" | sed 's/^./\l&/')" >&2
        exit 1
        ;;
    esac
    ;;
esac

# Cảnh báo (không chặn) nếu tiêu đề quá dài.
len=$(printf '%s' "$subject" | wc -c)
if [ "$len" -gt 72 ]; then
  echo "⚠ Tiêu đề dài ${len} ký tự (>72) — nên rút gọn." >&2
fi

exit 0
