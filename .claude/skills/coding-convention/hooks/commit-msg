#!/bin/sh
# MiniServer — commit-msg hook: enforce Conventional Commits (English).
# Install: copy this file to <repo>/.git/hooks/commit-msg (chmod +x on Unix).
# Source of truth: D:\Projects\MiniServer\.claude\skills\coding-convention\hooks\commit-msg

msg_file="$1"
# Subject line = first non-comment line.
subject="$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)"

# Skip special commits generated by git itself.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"Reapply "*) exit 0 ;;
esac

# <type>(<scope>)?(!)?: <subject>   — scope optional, '!' marks a breaking change.
pattern='^(feat|fix|refactor|chore|docs|test|perf|style|build|ci|revert)(\([a-z0-9._-]+\))?(!)?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "✖ Commit message does NOT follow Conventional Commits." >&2
  echo "" >&2
  echo "  Received  : $subject" >&2
  echo "  Expected  : <type>(<scope>): <English description, imperative mood>" >&2
  echo "  type      : feat fix refactor chore docs test perf style build ci revert" >&2
  echo "" >&2
  echo "  Examples  : feat(auth): add Authentik login" >&2
  echo "              fix(api): handle empty tag returning 500" >&2
  exit 1
fi

# Subject must not end with a period.
case "$subject" in
  *".") echo "✖ Commit subject must not end with '.'  → $subject" >&2; exit 1 ;;
esac

# Description (the part after ": ") must start lowercase — except all-caps acronyms (API, JWT, SSO…).
desc="${subject#*: }"
first_word="${desc%% *}"
first_char="$(printf '%s' "$desc" | cut -c1)"
case "$first_char" in
  [A-Z])
    # A lowercase letter in the first word ⇒ a normally capitalized word (Add, Authentik) ⇒ block.
    # No lowercase letter ⇒ all-caps acronym ⇒ allow.
    case "$first_word" in
      *[a-z]*)
        echo "✖ Commit description must start lowercase (imperative mood)." >&2
        echo "  Received  : $subject" >&2
        echo "  Fix to    : ${subject%%: *}: $(printf '%s' "$desc" | sed 's/^./\l&/')" >&2
        exit 1
        ;;
    esac
    ;;
esac

# Warning (non-blocking) if the subject is too long.
len=$(printf '%s' "$subject" | wc -c)
if [ "$len" -gt 72 ]; then
  echo "⚠ Subject is ${len} characters (>72) — consider shortening." >&2
fi

exit 0
