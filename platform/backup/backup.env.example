# Copy to /etc/restic/backup.env on the NUC, then: chmod 600 /etc/restic/backup.env
# NEVER commit real values (invariant #4). Set via the /nuc-set-env-style local mirror.

# --- restic repo (Backblaze B2 over the S3-compatible endpoint) ---
RESTIC_REPOSITORY=s3:s3.us-west-002.backblazeb2.com/<your-bucket>
RESTIC_PASSWORD_FILE=/etc/restic/password   # chmod 600; ALSO store this password OFFSITE (password manager) —
                                            # if the NUC dies, the encrypted repo is unrecoverable without it.
B2_ACCOUNT_ID=<b2-keyID>
B2_ACCOUNT_KEY=<b2-applicationKey>

# --- optional: immediate failure alert (reuses a Discord channel) ---
DISCORD_WEBHOOK_URL=

# --- DB config — VERIFY against the live NUC (plan step 1) ---
# Postgres: container:user:db  (db=ALL -> pg_dumpall). Confirm the real container names + users.
PG_DUMPS=authentik-postgresql:authentik:ALL,journal-db:postgres:ALL
# SQLite: volume_name:relative/db/path  (host /var/lib/docker/volumes/<vol>/_data/<path>).
# VERIFY the actual db filenames; confirm n8n_data is SQLite (and todo_data's engine).
SQLITE_DBS=yakudoku_data:db.sqlite3,n8n_data:database.sqlite

# --- optional: override which paths restic snapshots (default = all named volumes) ---
# VOLUME_PATHS=/var/lib/docker/volumes
